# Copy to .env in this backend directory. Never commit credentials or .env.
# Download a service-account JSON for the SAME project used by Flutter Firebase.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=credentials/service-account.json
# Alternative (takes precedence); absolute paths also supported:
# GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Set both before opening /admin (HTTP Basic; use HTTPS outside localhost).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# JSON array, no wildcard; match your fixed Flutter web port.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080"]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
RETRIEVAL_MIN_SIMILARITY=0.30
MAX_UPLOAD_BYTES=20971520
# Storage defaults are backend-local SQLite/Chroma/uploads/cache.
# DATA_PDF_DIR defaults to ../data beside this backend, independent of working directory.
# DATABASE_URL=sqlite:///./tanyaumrah.db
# DATA_PDF_DIR=C:/path/to/Project Akhir/data
